<?xml version="1.0" encoding="utf-8"?>
<!--
    The languages Android 13+ offers in the app's language setting. List every language with a
    composeApp/src/commonMain/composeResources/values-<lang> folder, and keep CFBundleLocalizations
    in iosApp/iosApp/Info.plist the same.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="zh-HK" />
    <locale android:name="zh-TW" />
</locale-config>
