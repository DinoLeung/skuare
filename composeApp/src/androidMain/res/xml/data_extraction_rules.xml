<?xml version="1.0" encoding="utf-8"?>
<!--
    Backups and device transfers take everything but the find phone ringtone's copy
    (AndroidCustomSoundStore): a large one could take Auto Backup over its 25 MB quota, which skips
    the whole app, the database with the installation id included. Without the copy, find phone rings
    with the built-in tone and App settings says the custom sound is missing.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="find_phone/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="find_phone/" />
    </device-transfer>
</data-extraction-rules>
