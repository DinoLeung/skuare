<?xml version="1.0" encoding="utf-8"?>
<!--
	Base (English) strings. Placeholders are positional (%1$s, %1$d), Compose resources supports no
	other format. Write apostrophes as a plain ', Compose resources doesn't unescape \' like Android.
-->
<resources>
	<!-- Shared -->
	<!-- The app's name, the title bar shows it when no tab is open -->
	<string name="app_name" translatable="false">Skuare</string>
	<string name="common_cancel">Cancel</string>
	<string name="common_close">Close</string>
	<string name="common_confirm">Confirm</string>
	<string name="common_delete">Delete</string>
	<string name="common_disconnect">Disconnect</string>
	<string name="common_others">Others</string>
	<string name="common_save">Save</string>
	<string name="common_selected">Selected</string>
	<string name="common_unknown_error">Unknown error</string>
	<!-- Joins two items of a list, applied repeatedly for longer ones: "Alarms, Timer, Settings" -->
	<string name="common_list_join">%1$s, %2$s</string>

	<!-- Tabs and title bar -->
	<string name="nav_timezones">Timezones</string>
	<string name="nav_alarms">Alarms</string>
	<string name="nav_timer">Timer</string>
	<string name="nav_reminders">Reminders</string>
	<string name="nav_settings">Settings</string>
	<string name="nav_adjust_watch_features">Adjust watch features</string>
	<!-- Stands in for the watch's model name when it didn't advertise one -->
	<string name="nav_this_watch">This watch</string>
	<!-- Stands in for the watch's model name in demo mode, see pairing_connect_demo_watch -->
	<string name="nav_demo_watch">Demo watch</string>

	<!-- Pairing -->
	<string name="pairing_stop_searching">Stop searching</string>
	<string name="pairing_pair_new_watch">Pair a new watch</string>
	<!-- Opens the watch screens with a demo watch, no watch or Bluetooth needed -->
	<string name="pairing_connect_demo_watch">Connect to a demo watch</string>
	<!-- Opens the menu in the pairing screen's title bar -->
	<string name="pairing_more_options">More options</string>
	<string name="pairing_grant_permissions">Grant permissions from app settings</string>
	<string name="pairing_no_watches">No paired watches</string>
	<string name="pairing_no_watches_hint">Press and hold the MODE button (lower-left) on your watch, then tap + to pair it.</string>
	<string name="paired_watch_forget_button">Forget watch</string>
	<!-- %1$s: the watch's name -->
	<string name="paired_watch_forget_title">Forget %1$s?</string>
	<string name="paired_watch_forget_text">It won't adjust its time in the background until you pair it again.</string>
	<string name="paired_watch_forget_confirm">Forget</string>
	<string name="paired_watch_never_synced">Never synced</string>
	<!-- %1$s: date and time of the last sync -->
	<string name="paired_watch_last_synced">Last synced %1$s</string>
	<!-- %1$s: date and time of the last sync -->
	<string name="paired_watch_last_sync_failed">Last sync failed %1$s</string>
	<!-- Checkbox in the forget dialog, unchecked by default. %1$d: how many locations the watch has -->
	<plurals name="paired_watch_forget_delete_locations">
		<item quantity="one">Also delete its recorded location</item>
		<item quantity="other">Also delete its %1$d recorded locations</item>
	</plurals>

	<!-- App settings, opened from the gear in the title bar. Settings of the app itself, the Settings tab is the watch's -->
	<string name="app_settings_title">App settings</string>
	<string name="app_settings_back">Back</string>
	<string name="app_settings_location_title">Record location</string>
	<string name="app_settings_location_switch">Save the phone's location when the lower-right button is pressed briefly</string>
	<string name="app_settings_location_description">The watch syncs its time as usual, and Skuare saves where your phone is. Needs precise location, allowed all the time.</string>
	<!-- Shown when the switch is turned on, before the system's location prompts. Google Play requires this disclosure for background location, keep "even when Skuare is closed or not in use" -->
	<string name="app_settings_location_disclosure_title">Allow location in the background?</string>
	<string name="app_settings_location_disclosure_text">Skuare collects location data to save where your phone is when you briefly press the lower-right button on your watch, even when Skuare is closed or not in use. Locations stay on this phone, Skuare never sends them anywhere. Next, allow precise location, then allow it all the time.</string>
	<string name="app_settings_location_disclosure_continue">Continue</string>
	<!-- The switch is on, but the permission was taken away in the system settings since -->
	<string name="app_settings_location_permission_missing">Location isn't allowed all the time, so no locations are saved.</string>
	<!-- Turning the switch on failed, the user didn't allow the location -->
	<string name="app_settings_location_permission_denied">Location wasn't allowed. Allow precise location all the time in the system settings.</string>
	<!-- Opens the system's settings page for Skuare, where permissions are changed -->
	<string name="app_settings_open_system_settings">Open system settings</string>
	<!-- On a platform without background sync, e.g. iOS for now -->
	<string name="app_settings_location_unsupported">Not available on this device yet, it needs background sync.</string>
	<!-- Phone finder: holding the watch's lower-right button rings the phone -->
	<string name="app_settings_find_phone_title">Phone finder</string>
	<string name="app_settings_find_phone_switch">Ring the phone when the lower-right button is held</string>
	<string name="app_settings_find_phone_description">Hold the lower-right button on your watch and the phone rings like an alarm, also in silent mode. Stop it from the notification or in Skuare.</string>
	<!-- Raises the alarm volume to its maximum while it rings, back afterwards. Off, it rings at the alarm volume the user set -->
	<string name="app_settings_find_phone_max_volume">Ring at full alarm volume</string>
	<string name="app_settings_find_phone_until_stopped">Ring until stopped</string>
	<!-- Label of the ring length field, hours, minutes and seconds -->
	<string name="app_settings_find_phone_ring_for">Ring for</string>
	<string name="app_settings_find_phone_ring_length_error">At least 1 second</string>
	<!-- iOS, which doesn't let an app raise the phone's volume -->
	<string name="app_settings_find_phone_volume_note">Rings at the phone's current volume, apps can't raise it on this system.</string>
	<!-- The switch is on, but notifications were turned off in the system settings since -->
	<string name="app_settings_find_phone_notifications_missing">Notifications are off, so the ringing has no Stop button in a notification.</string>
	<!-- Turning the switch on failed, the user didn't allow notifications -->
	<string name="app_settings_find_phone_notifications_denied">Notifications weren't allowed. Allow them in the system settings for the Stop button.</string>
	<!-- On a platform without background sync, e.g. iOS for now -->
	<string name="app_settings_find_phone_unsupported">Not available on this device yet, it needs background sync.</string>
	<!-- %1$s: the picked file's name, or app_settings_find_phone_sound_default -->
	<string name="app_settings_find_phone_sound">Sound: %1$s</string>
	<string name="app_settings_find_phone_sound_default">Built-in tone</string>
	<!-- Opens the system's file picker for an audio file -->
	<string name="app_settings_find_phone_sound_choose">Choose</string>
	<string name="app_settings_find_phone_sound_reset">Use the built-in tone</string>
	<!-- Plays the sound at the phone's current volume until tapped again (find_phone_stop), the sound only, no notification -->
	<string name="app_settings_find_phone_sound_play">Play sound</string>
	<!-- The picked sound's copy is gone, e.g. after restoring a backup, which leaves it out -->
	<string name="app_settings_find_phone_sound_missing">The copy of your sound is missing, the built-in tone rings instead. Choose it again.</string>
	<!-- %1$d: the largest file size allowed, in megabytes -->
	<string name="app_settings_find_phone_sound_too_large">This file is larger than %1$d MB.</string>
	<string name="app_settings_find_phone_sound_unplayable">This phone can't play this file.</string>
	<string name="app_settings_find_phone_sound_failed">This file couldn't be read.</string>

	<!-- Over every screen while find phone rings, its only button stops it -->
	<string name="find_phone_ringing_title">Your phone is ringing</string>
	<string name="find_phone_ringing_text">Your watch is looking for this phone.</string>
	<string name="find_phone_stop">Stop</string>

	<!-- Recorded locations, a list of where the phone was at each short press of the lower-right button -->
	<string name="locations_title">Recorded locations</string>
	<string name="locations_empty">No locations recorded yet</string>
	<!-- Location recording is off -->
	<string name="locations_empty_hint_off">Turn on Record location in App settings, then briefly press the lower-right button on your watch.</string>
	<!-- Location recording is on -->
	<string name="locations_empty_hint_on">Briefly press the lower-right button on your watch to record where your phone is.</string>
	<!-- Latitude and longitude in decimal degrees, the format map apps read, the same in every language -->
	<string name="locations_coordinates" translatable="false">%1$s, %2$s</string>
	<!-- %1$d: radius around the position in meters -->
	<string name="locations_accuracy">± %1$d m</string>
	<!-- Tapping a location opens it in a map app, shown when the phone has none that can -->
	<string name="locations_no_map_app">No app can show this location</string>
	<!-- Snackbar after deleting one location from its long-press menu, with locations_undo -->
	<string name="locations_deleted">Location deleted</string>
	<string name="locations_undo">Undo</string>
	<!-- Title bar button and its confirmation -->
	<string name="locations_delete_all">Delete all locations</string>
	<string name="locations_delete_all_title">Delete all locations?</string>
	<!-- %1$d: how many locations there are -->
	<plurals name="locations_delete_all_text">
		<item quantity="one">The recorded location will be deleted. This can't be undone.</item>
		<item quantity="other">All %1$d recorded locations will be deleted. This can't be undone.</item>
	</plurals>
	<!-- Title bar button and the title of its dialog, which offers the ages below -->
	<string name="locations_delete_older">Delete older locations</string>
	<string name="locations_older_than_week">Older than 1 week</string>
	<string name="locations_older_than_month">Older than 1 month</string>
	<string name="locations_older_than_three_months">Older than 3 months</string>
	<string name="locations_older_than_six_months">Older than 6 months</string>
	<string name="locations_older_than_year">Older than 1 year</string>
	<!-- Confirm button of the older locations dialog. %1$d: how many the picked age deletes -->
	<plurals name="locations_delete_count">
		<item quantity="one">Delete %1$d location</item>
		<item quantity="other">Delete %1$d locations</item>
	</plurals>

	<!-- Timezones -->
	<string name="timezones_select_home">Select home time zone</string>
	<string name="timezones_select_world">Select world time zone</string>
	<string name="clock_home_time">Home Time</string>
	<string name="clock_world_time">World Time</string>
	<!-- Daylight saving time -->
	<string name="clock_dst">DST</string>
	<string name="clock_pin">Pin</string>
	<string name="timezone_picker_title">Select time zone</string>
	<string name="timezone_picker_search">Time zone</string>
	<string name="timezone_picker_clear_search">Clear search</string>
	<!-- Daylight saving time -->
	<string name="timezone_picker_dst">DST</string>
	<string name="timezone_picker_no_results">No matching time zones</string>
	<!-- DST setting: follows the city's DST dates -->
	<string name="dst_auto">Auto</string>
	<string name="dst_on">On</string>
	<string name="dst_off">Off</string>

	<!-- Alarms -->
	<string name="alarms_title">Alarms</string>
