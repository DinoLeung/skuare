	<string name="reminder_never">Never</string>
	<string name="reminder_starts_on">Starts On</string>

	<!-- Settings -->
	<string name="settings_display">Display</string>
	<string name="settings_24_hour_format">24 Hour format</string>
	<string name="settings_date_format">Date Format</string>
	<string name="settings_weekday_language">Weekday Language</string>
	<string name="settings_font_style">Font style</string>
	<string name="settings_backlight">Backlight</string>
	<string name="settings_auto_backlight">Auto Backlight</string>
	<string name="settings_backlight_duration">Backlight Duration</string>
	<string name="settings_time_adjustment">Time Adjustment</string>
	<string name="settings_auto_time_adjustment">Auto Time Adjustment</string>
	<string name="settings_minutes_past_hour">Minutes past the hour</string>
	<!-- %1$s: minutes past the hour, two digits, e.g. 15. The hours are fixed by the watch -->
	<string name="settings_auto_time_adjustment_schedule">The watch adjusts its time at 00:%1$s, 06:%1$s, 12:%1$s and 18:%1$s</string>
	<string name="settings_auto_time_adjustment_off">The watch won't adjust its time automatically</string>
	<string name="settings_watch_name">Watch Name</string>
	<string name="settings_power_saving_mode">Power Saving Mode</string>
	<string name="settings_mute_button_tone">Mute Button Tone</string>
	<string name="settings_connection_timeout">Connection Timeout</string>
	<string name="settings_adjust_hands">Adjust Hands</string>

	<!-- Hand adjustment -->
	<string name="hand_adjust_title">Adjust Hands</string>
	<string name="hand_adjust_moving">Moving the hands…</string>
	<string name="hand_adjust_moving_to_position">Moving the hands to the adjusting position…</string>
	<string name="hand_adjust_steps">Steps</string>
	<string name="hand_adjust_anticlockwise">Anticlockwise</string>
	<string name="hand_adjust_clockwise">Clockwise</string>
	<string name="hand_adjust_set">Set</string>
	<string name="hand_adjust_finish">Finish</string>
	<string name="hand_adjust_clock_step_hint">3 steps is 1 minute</string>
	<string name="hand_adjust_mode_step_hint">90 steps is half a turn</string>

	<!-- Watch error dialog -->
	<string name="watch_error_title">Watch error</string>
	<string name="watch_error_clocks">The watch couldn't send its clocks. It only sends them once after connecting, asking again, e.g. after changing the watch features, returns this error until it reconnects. Asking for more clocks than it has returns it too.</string>
	<string name="watch_error_clocks_check_features">Check the number of clocks your watch has in its features, saving disconnects the watch. If it is already right, disconnect. Then reconnect it from the watch.</string>
	<string name="watch_error_clocks_reconnect">Disconnect, then reconnect it from the watch.</string>
	<string name="watch_error_request">The watch couldn't complete the request, anything that didn't load stays disabled.</string>
	<string name="watch_error_keeps_happening">If it keeps happening, disconnect and reconnect it from the watch.</string>
	<string name="watch_error_adjust_features">Adjust features</string>

	<!-- Disconnect dialog -->
	<string name="disconnect_title">Disconnect the watch?</string>
	<!-- %1$s: the tabs with unsaved changes, e.g. "Alarms, Settings" -->
	<string name="disconnect_unsaved_changes">Unsaved changes on %1$s will be discarded. Save them first to keep them.</string>

	<!-- Watch features dialog, for watches the app doesn't know yet -->
	<!-- %1$s: the watch's model name, e.g. CASIO GBD-H2000 -->
	<string name="custom_model_title">%1$s features</string>
	<string name="custom_model_clocks">Clocks</string>
	<string name="custom_model_clocks_hint">Home time plus the world times your watch shows.</string>
	<string name="custom_model_reminders">Reminders</string>
	<string name="custom_model_reminders_hint">0 if your watch has none, anything above adds the Reminders tab.</string>
	<string name="custom_model_font_style">Font style</string>
	<string name="custom_model_font_style_hint">Your watch has a display font setting.</string>
	<string name="custom_model_short_city_names">Short city names</string>
	<string name="custom_model_short_city_names_hint">Your watch shows 3-letter city codes, e.g. TYO.</string>
	<string name="custom_model_weekday_language">Weekday language</string>
	<string name="custom_model_weekday_language_hint">The weekday can be shown in other languages.</string>
	<string name="custom_model_snooze_alarm">Snooze alarm</string>
	<string name="custom_model_snooze_alarm_hint">Your watch's fifth alarm is a snooze alarm, off if it's a normal alarm.</string>
	<string name="custom_model_time_zone_location">Time zone location</string>
	<string name="custom_model_time_zone_location_hint">Also sends each city's location and radio station with its time zone.</string>
	<string name="custom_model_hand_adjustment">Hand adjustment</string>
	<string name="custom_model_hand_adjustment_hint">Your watch has hands to adjust, a clock hand and a mode hand like the GA-B2100.</string>
	<string name="custom_model_warning">Turning on something your watch doesn't have can make syncing fail. If time sync starts failing, turn it back off.</string>
	<string name="custom_model_disconnects_on_save">The watch returned an error, saving disconnects it so it can recover. Reconnect it from the watch afterwards.</string>
	<string name="custom_model_unsaved_other_tabs">Unsaved changes on other tabs will be discarded.</string>
	<!-- %1$s: the watch's model name, e.g. CASIO GBD-H2000 -->
	<string name="custom_model_intro_title">%1$s isn't fully supported yet</string>
	<string name="custom_model_intro_text">Only the basics are on: a home clock and one world clock. Use the wrench button in the title bar to turn on the features your watch has.</string>
	<string name="custom_model_intro_adjust">Adjust</string>
	<string name="custom_model_intro_later">Later</string>

	<!-- Watch setting values -->
	<string name="timer_status_not_started">Not Started</string>
	<string name="timer_status_active">Active</string>
	<string name="timer_status_suspended">Suspended</string>
	<!-- Hands of an analog watch: the hour and minute hands, adjusted together -->
	<string name="hand_group_clock">Clock hands</string>
	<!-- Hand of an analog watch that points at the current mode -->
	<string name="hand_group_mode">Mode hand</string>
	<!-- Display font of the watch -->
	<string name="font_style_standard">Standard</string>
	<string name="font_style_classic">Classic</string>
	<string name="backlight_duration_short">Short</string>
	<string name="backlight_duration_long">Long</string>
	<string name="reminder_recurrence_once">Once</string>
	<string name="reminder_recurrence_daily">Daily</string>
	<string name="reminder_recurrence_weekly">Weekly</string>
	<string name="reminder_recurrence_monthly">Monthly</string>
	<string name="reminder_recurrence_yearly">Yearly</string>
	<!-- Languages the watch can show the weekday in -->
	<string name="weekday_language_english">English</string>
	<string name="weekday_language_spanish">Spanish</string>
	<string name="weekday_language_french">French</string>
	<string name="weekday_language_german">German</string>
	<string name="weekday_language_italian">Italian</string>
	<string name="weekday_language_russian">Russian</string>
	<!-- Errors -->
	<!-- %1$d: the most characters the watch stores, e.g. 18 for a reminder title -->
	<plurals name="error_text_too_long">
		<item quantity="one">At most %1$d character</item>
		<item quantity="other">At most %1$d characters</item>
	</plurals>
	<!-- %1$d: hours the duration must be shorter than, e.g. a timer under 24 hours -->
	<plurals name="error_duration_too_long_hours">
		<item quantity="one">Must be shorter than %1$d hour</item>
		<item quantity="other">Must be shorter than %1$d hours</item>
	</plurals>
	<!-- %1$d and %2$d: the smallest and largest allowed number -->
	<string name="error_value_out_of_range">Must be between %1$d and %2$d</string>
	<!-- %1$s: the error packet's bytes in hex, e.g. FF 81 1A -->
	<string name="error_watch_replied">The watch returned an error: %1$s</string>
	<string name="error_watch_timeout">The watch didn't respond in time</string>
	<string name="error_connection_lost">The connection to the watch was lost</string>
	<!-- %1$s: a technical description in English, kept for bug reports -->
	<string name="error_unexpected">Something went wrong: %1$s</string>

	<!-- %1$d: minutes the watch stays connected without activity -->
	<plurals name="settings_connection_timeout_minutes">
		<item quantity="one">%1$d minute</item>
		<item quantity="other">%1$d minutes</item>
	</plurals>
</resources>
